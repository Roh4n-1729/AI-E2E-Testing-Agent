# Model in "provider/model" form (Stagehand / AI SDK naming).
AIE2E_MODEL=anthropic/claude-haiku-4-5

# Provider key matching the model prefix (only one is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# AIE2E_HEADLESS=true
# AIE2E_OUT_DIR=.aie2e
# AIE2E_MAX_STEPS=20
# AIE2E_SHOW_CURSOR=true   # draw a visible cursor + click ripple so you can watch the run
# AIE2E_THINKING_EFFORT=none   # none | low | medium | high (agent thinking; none is the stable default)
# AIE2E_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# AIE2E_CHROME_ARGS=--disable-dev-shm-usage   # extra Chrome flags
# AIE2E_IGNORE_NETWORK=analytics\.example\.com,sentry\.io   # known third-party noise (regexes)
# AIE2E_IGNORE_CONSOLE=ResizeObserver loop
# AIE2E_CHROME_SANDBOX=true   # Linux only: keep Chrome's sandbox (off by default, like Playwright)
# AIE2E_LOG_LEVEL=info
# AIE2E_CONCURRENCY=1
# AIE2E_QUALITY_GATE=warn   # off | warn (advisory, default) | fail (Web Vitals / a11y breach fails the test)
# Optional stronger models for the low-volume, high-leverage calls (the browser agent stays on AIE2E_MODEL):
# Models by role in one word: economy | balanced | best (explicit models below win)
#   economy:  agent haiku-4-5 · planner haiku-4-5 · judge haiku-4-5
#   balanced: agent haiku-4-5 · planner sonnet-5-5 · judge sonnet-5-5
#   best:     agent sonnet-4-6 · planner opus-5-5 · judge opus-5-5
# AIE2E_PRESET=balanced
# The browser agent runs on Stagehand 3.7.3: claude-*-5-5 models break its loop; the planner and judge take any model.
# AIE2E_PLANNER_MODEL=anthropic/claude-sonnet-4-5
# AIE2E_JUDGE_MODEL=anthropic/claude-sonnet-4-5

# Login (for apps behind a login). Used only by the harness's own login step: never stored in suites or
# reports, never sent to the AI. Give the login page with --login-url, the New run form, or a suite's "auth".
# AIE2E_USERNAME=
# AIE2E_PASSWORD=

# Theme and visual testing
# AIE2E_THEME_STATES=4        # screens audited per test besides the final one (0 = final only)
# AIE2E_VISUAL_GATE=warn      # off | warn (show differences for review) | fail (a difference fails the test)
# AIE2E_BASELINES_DIR=tests/visual-baselines   # commit approved screenshots with the code
# AIE2E_SUITES_DIR=tests/suites                # suites written in the UI, committed with the code

# After the verdict, the judge model explains each FAILED test in plain words (app bug, test problem,
# environment). Advisory, never changes pass/fail, no calls on a green run. Set false to switch it off.
# AIE2E_EXPLAIN=false
# Replay each new recording once (no AI) before keeping it; false skips that check
# AIE2E_VERIFY_RECORDINGS=false
# When the AI's reading blames a failure on the test, retry once with that reading as a hint; false turns it off
# AIE2E_RETRY_TEST_PROBLEMS=false

# File pickers are answered with a bundled sample (assets/uploads: PNG, JPEG, PDF, CSV, text, JSON). Files in this
# folder come first, for apps that need another kind (a video, a .docx).
# AIE2E_UPLOAD_DIR=./my-upload-files
# With the browser shown (--headed, or "Open a real browser window"), the agent can ask you for a step only a
# person can do (a code, a CAPTCHA). How long it waits for you, in ms (default 5 minutes):
# AIE2E_HELP_WAIT_MS=300000

# Anthropic prompt caching: repeated prompts (the planner's and judge's instructions, our agent loop's conversation)
# are read back from a cache at a tenth of the input price. 5m (default), 1h (costlier writes, longer reuse) or off.
# AIE2E_PROMPT_CACHE=5m

# Who drives the browser for a goal: stagehand (default, Stagehand 3.7.3 agent) or loop (our own AI SDK
# tool loop on Playwright's accessibility snapshot: takes any model id, e.g. anthropic/claude-sonnet-5-5).
# Experimental: replay and healing work the same way; compare on your app before switching.
# AIE2E_AGENT_ENGINE=loop
