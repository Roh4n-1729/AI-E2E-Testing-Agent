# Model in "provider/model" form (Stagehand / AI SDK naming).
AIE2E_MODEL=anthropic/claude-haiku-4-5

# Provider key matching the model prefix (only one is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# AIE2E_HEADLESS=true
# AIE2E_OUT_DIR=.aie2e
# AIE2E_MAX_STEPS=20
# AIE2E_SHOW_CURSOR=true   # draw a visible cursor + click ripple so you can watch the run
# AIE2E_THINKING_EFFORT=none   # none | low | medium | high (agent thinking; none is the stable default)
# AIE2E_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# AIE2E_CHROME_ARGS=--no-sandbox   # only in containers/CI as root
# AIE2E_LOG_LEVEL=info
# AIE2E_CONCURRENCY=1
# AIE2E_QUALITY_GATE=warn   # off | warn (advisory, default) | fail (Web Vitals / a11y breach fails the test)
# Optional stronger models for the low-volume, high-leverage calls (the browser agent stays on AIE2E_MODEL):
# AIE2E_PLANNER_MODEL=anthropic/claude-sonnet-4-5
# AIE2E_JUDGE_MODEL=anthropic/claude-sonnet-4-5
