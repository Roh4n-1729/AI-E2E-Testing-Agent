{
  "name": "ai-e2e-agent",
  "version": "0.2.0",
  "description": "AI-agent-driven E2E frontend testing: plan, execute, strictly judge, report. Agents author and repair tests; plain Playwright replays them.",
  "private": true,
  "type": "module",
  "bin": {
    "aie2e": "./src/cli/main.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/cli/main.js",
    "dev": "node --watch src/cli/main.js",
    "check": "tsc -p jsconfig.json && tsc -p types/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests --exclude tests/integration",
    "test:int": "vitest run tests/integration",
    "browsers": "playwright install chromium",
    "doctor": "node src/cli/main.js doctor",
    "diagrams": "node scripts/diagrams.js",
    "ui": "npm run ui:build && node src/cli/main.js ui",
    "ui:build": "vite build --config ui/vite.config.js",
    "ui:dev": "vite --config ui/vite.config.js",
    "eval": "node scripts/evaluate.js",
    "shop": "node examples/buggy-shop/server.js",
    "todomvc": "node examples/todomvc/server.js",
    "saucedemo": "node examples/saucedemo/server.js",
    "graph": "node scripts/graph.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.81",
    "@ai-sdk/google": "^2.0.53",
    "@ai-sdk/openai": "^2.0.53",
    "@browserbasehq/stagehand": "3.7.3",
    "@fastify/static": "^8.3.0",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "ai": "^5.0.185",
    "axe-core": "^4.14.0",
    "commander": "^14.0.0",
    "culori": "^4.0.2",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.7",
    "pixelmatch": "7.2.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "lucide-react": "^1.64.0",
    "prettier": "^3.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "yet-another-react-lightbox": "^3.32.2"
  }
}
