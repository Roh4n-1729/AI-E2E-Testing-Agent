classDiagram
  direction LR
  class RunReport {
    runId
    startedAt
    targetUrl
    summary
  }
  class TestCase {
    id
    title
    goal
    startUrl
    maxSteps
  }
  class Expectation {
    kind: url | text-visible | selector-visible
    kind: no-console-errors | no-network-failures | visual
  }
  class TestResult {
    mode: agent | replay | healed | deterministic
    durationMs
    claimMismatch
  }
  class ExecutionOutcome {
    mode
    agentClaim
    error
  }
  class Verdict {
    status: pass | fail | error
    reason
    warnings
  }
  class CheckResult {
    passed
    detail
  }
  class Evidence {
    finalUrl
    title
    ariaSnapshotPath
    pageTextExcerpt
  }
  class Screenshot {
    label
    path
    source: harness | agent
  }
  class RecordedStep {
    index
    kind: navigate | act
    selector
    method
    arguments
  }
  class Recording {
    schemaVersion
    fingerprint
    recordedAt
  }
  class HealEvent {
    stepIndex
    oldSelector
    newSelector
    outcome
  }

  RunReport "1" o-- "*" TestResult
  TestResult --> TestCase
  TestCase "1" o-- "*" Expectation
  TestResult --> Verdict
  TestResult --> Evidence
  TestResult --> ExecutionOutcome
  TestResult "1" o-- "*" HealEvent
  Verdict "1" o-- "*" CheckResult
  CheckResult --> Expectation
  Evidence "1" o-- "*" Screenshot
  ExecutionOutcome "1" o-- "*" RecordedStep
  Recording "1" o-- "*" RecordedStep
  Recording --> TestCase : fingerprint of goal, url, expectations
