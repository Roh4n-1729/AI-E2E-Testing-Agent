classDiagram
  direction LR
  class Suite {
    url
    description
    auth
    themeFrom
  }
  class RunReport {
    runId
    targetUrl
    summary
    auth
    consistency
  }
  class TestCase {
    id
    title
    goal
    startUrl
    steps
  }
  class Expectation {
    url · text-visible · selector-visible
    no-console-errors · no-network-failures
    visual · api-call · download · text-appeared
    web-vitals · no-a11y-violations
    theme-conformance · visual-baseline
  }
  class TestResult {
    mode: agent | replay | healed | deterministic
    durationMs
    claimMismatch
  }
  class Verdict {
    status: pass | fail | error
    reason
    warnings
  }
  class CheckResult {
    passed
    detail
  }
  class Evidence {
    finalUrl
    console · network
    vitals · a11y
  }
  class ThemeState {
    fingerprint
    label
    audit per theme
  }
  class VisualCapture {
    checkpoint
    status: new | unchanged | changed
    diffRatio
  }
  class Screenshot {
    label
    source: harness | agent
  }
  class RecordedStep {
    kind: navigate | act | mouse | wait
    selector
    fallbackSelectors
    method
    arguments
  }
  class HealEvent {
    stepIndex
    oldSelector
    newSelector
  }

  Suite "1" o-- "*" TestCase
  RunReport "1" o-- "*" TestResult
  TestResult --> TestCase
  TestCase "1" o-- "*" Expectation
  TestCase "1" o-- "*" RecordedStep
  TestResult --> Verdict
  TestResult --> Evidence
  TestResult "1" o-- "*" HealEvent
  Verdict "1" o-- "*" CheckResult
  CheckResult --> Expectation
  Evidence "1" o-- "*" Screenshot
  Evidence "1" o-- "*" ThemeState
  Evidence "1" o-- "*" VisualCapture
