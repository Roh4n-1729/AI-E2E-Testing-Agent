flowchart TB
  dev([Developer]) --> ui
  dev --> cli
  ci([CI: GitHub Action]) --> cli

  subgraph app["ai-e2e-agent (Node, JavaScript + JSDoc types)"]
    ui["Web UI<br/>React + Fastify + SSE<br/>new run · live view · suites · review"]
    cli["CLI<br/>run · export · doctor"]
    start["startRun()<br/>config · login once · theme reference · baselines"]

    subgraph lg["LangGraph: crawl → plan → runTest ×N → writeReport"]
      direction LR
      crawl["Crawler<br/>capped BFS, same-origin"] --> plan["Planner<br/>suite / cached / LLM"]
      plan --> run["TestRunner<br/>fresh browser per test, in parallel"]
      run --> report["Reporters<br/>JSON + HTML"]
    end

    subgraph test["One test"]
      direction LR
      exec["Executor<br/>replay → heal → agent"]
      session["BrowserSession<br/>Playwright + Stagehand<br/>collectors · settle · cursor"]
      judge["Strict judge<br/>harness evidence only"]
      exec --> session --> judge
    end

    subgraph checks["Evidence the judge reads"]
      direction LR
      basic["DOM · URL · console · network"]
      quality["Web Vitals · axe a11y<br/>API calls · downloads · toasts"]
      theme["Theme audit<br/>every screen, every theme<br/>consistency · --theme-from"]
      visual["Visual regression<br/>pixelmatch vs baselines"]
    end

    ui --> start
    cli --> start
    start --> lg
    run --> test
    judge --> checks
  end

  exec -. "act / observe / agent" .-> llm[("LLM<br/>AIE2E_MODEL")]
  plan -. "plan tests" .-> llm
  judge -. "visual questions" .-> llm
  session --> target[("App under test")]
  exec <--> store[(".aie2e/cache<br/>recorded steps")]
  visual <--> baselines[("baselines/<br/>approved PNGs")]
  ui <--> suites[("suites/*.json")]
  report --> out[(".aie2e/runs/&lt;id&gt;/<br/>report · screenshots · diffs")]
